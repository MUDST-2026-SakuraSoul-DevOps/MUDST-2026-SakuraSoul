# ก๊อปไฟล์นี้เป็น .env แล้วใส่ค่าจริงลงไป
#
#   cp .env.example .env
#
# .env ถูก gitignore ไว้ ห้าม commit ขึ้น repo เด็ดขาด
# ไฟล์นี้มีแต่ชื่อตัวแปร ไม่มีค่าจริง จึง commit ได้
#
# ถ้ารหัสมีเครื่องหมาย $ ต้องเขียนเป็น $$ เพราะ docker compose ตีความ $ เป็นตัวแปร

# รหัสผ่านฐานข้อมูล docker-compose ส่งค่านี้ให้ทั้ง postgres และ Spring ที่ต่อเข้าไป
# ถ้ารัน ./gradlew bootRun เองต้องส่ง SPRING_DATASOURCE_PASSWORD ให้ตรงกับค่านี้ด้วย
# เพราะ bootRun ไม่ได้อ่าน .env (ดูวิธีในหัวข้อ How to Start? ของ README)
POSTGRES_PASSWORD=

# แอดมินคนแรกของระบบ สร้างให้อัตโนมัติตอนตาราง admin_user ยังว่างเท่านั้น
# ถ้าเคยสตาร์ตไปแล้ว การแก้ค่านี้จะไม่เปลี่ยนรหัสของคนเดิม ต้อง docker compose down -v ก่อน
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=
