# ก๊อปไฟล์นี้เป็น .env แล้วใส่ค่าจริงลงไป
#
#   cp .env.example .env
#
# .env ถูก gitignore ไว้ ห้าม commit ขึ้น repo เด็ดขาด
# ไฟล์นี้มีแต่ชื่อตัวแปร ไม่มีค่าจริง จึง commit ได้
#
# ถ้ารหัสมีเครื่องหมาย $ ต้องเขียนเป็น $$ เพราะ docker compose ตีความ $ เป็นตัวแปร

# รหัสผ่านฐานข้อมูล docker-compose ส่งค่านี้ให้ทั้ง postgres และ Spring ที่ต่อเข้าไป
# ถ้ารัน ./gradlew bootRun เองต้องส่ง SPRING_DATASOURCE_PASSWORD ให้ตรงกับค่านี้ด้วย
# เพราะ bootRun ไม่ได้อ่าน .env (ดูวิธีในหัวข้อ How to Start? ของ README)
POSTGRES_PASSWORD=

# แอดมินคนแรกของระบบ สร้างให้อัตโนมัติตอนตาราง admin_user ยังว่างเท่านั้น
# ถ้าเคยสตาร์ตไปแล้ว การแก้ค่านี้จะไม่เปลี่ยนรหัสของคนเดิม ต้อง docker compose down -v ก่อน
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=

# ที่อยู่ผู้ส่งของอีเมลใบเสร็จ (SSK-143) ไม่ใช่ความลับ ไม่ตั้งก็ได้ ค่าตั้งต้นคือ billing@sakura-soul.local
# อีเมลทุกฉบับไปตกที่ Mailpit ใน docker compose เปิดดูได้ที่ http://localhost:8025 ไม่มีอะไรออกนอกเครื่อง
APP_MAIL_FROM=

# อีเมลแจ้งเตือนของใกล้หมด (SSK-171) ไม่ใช่ความลับ ไม่ตั้งก็ได้
# ผู้รับ หลายคนคั่นด้วยจุลภาค ค่าตั้งต้นคือ admin@sakura-soul.local
APP_LOW_STOCK_ALERT_TO=
# เวลาที่ตรวจเป็น cron ของ Spring ตามเวลาไทย ค่าตั้งต้น 0 0 8 * * * (แปดโมงเช้า) ตั้ง - เพื่อปิด
# เดโมที่อยากเห็นอีเมลทันทีตั้ง 0 * * * * * (ทุกนาที) ของแต่ละชิ้นยังได้อีเมลครั้งเดียวต่อการข้ามเกณฑ์
APP_LOW_STOCK_ALERT_CRON=

# ชุด observability (SSK-182) ใช้เฉพาะตอนเปิดด้วย docker-compose.observability.yml
# ดูวิธีใช้ที่ observability/README.md ถ้าไม่ได้เปิดชุดนี้ ปล่อยว่างได้
#
# รหัสเข้า Grafana (ผู้ใช้ admin) http://localhost:3000
GRAFANA_ADMIN_PASSWORD=
# รหัสของผู้ใช้ metrics ที่ Prometheus ใช้ดึง /actuator/prometheus ของ backend
# ถ้าไม่ตั้ง endpoint นั้นจะเข้าไม่ได้เลย ตั้งเป็นค่าอะไรก็ได้ที่ไม่ว่างตอน dev
APP_METRICS_PASSWORD=

# รหัสที่ E2E (Cypress) ใช้ล็อกอิน ชุด mock/stubbed (npm test ใน e2e/) รับรหัสอะไรก็ได้ที่ไม่ว่าง
# ส่วนชุด live (npm run test:live) ล็อกอินกับ backend จริง ต้องตรงกับ APP_ADMIN_PASSWORD ข้างบน
# Cypress ไม่อ่านไฟล์นี้เอง ต้องส่งตอนสั่ง เช่น E2E_ADMIN_PASSWORD=... npm run test:live
E2E_ADMIN_USERNAME=
E2E_ADMIN_PASSWORD=
