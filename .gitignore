# frontend
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/test-results/
frontend/playwright-report/
frontend/*.tsbuildinfo

# tools
# ไฟล์ตั้งค่าของเครื่องมือส่วนตัวไม่ควรอยู่ใน repo ของทีม ใครใช้ตัวไหนก็ตั้งของตัวเองในเครื่อง
.idea/
*.iml
.vscode/
.claude/
.DS_Store
Thumbs.db

# ห้าม commit ไฟล์ env ที่มีรหัสผ่านจริง ครอบทุกชั้นของโปรเจกต์
# แล้วยกเว้นเป็นรายไฟล์เฉพาะตัวที่ตั้งใจ commit จริง ๆ คือแม่แบบที่ไม่มีค่า
# กับสองไฟล์ของ frontend ที่มีแค่ VITE_API_MOCK ไม่มีความลับ
.env
.env.*
!.env.example
!frontend/.env.development
!frontend/.env.test
*.local
